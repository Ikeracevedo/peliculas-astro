---
export const prerender = true;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Admin | CineVault</title>
  </head>
  <body class="min-h-screen bg-[#121212] text-gray-200">

    <!-- Header -->
    <header class="flex items-center justify-between border-b border-[#2a2a2a] px-6 py-4">
      <a href="/" class="text-xl font-bold text-[#a855f7]">CineVault</a>
      <nav class="flex items-center gap-6 text-sm">
        <a href="/" class="hover:text-white">Catálogo</a>
        <span class="text-gray-500 text-xs" id="userEmail"></span>
        <button
          id="btnLogout"
          class="rounded-lg border border-[#a855f7] px-4 py-1.5 text-[#a855f7] hover:bg-[#a855f7] hover:text-white transition-colors text-sm"
        >
          Cerrar sesión
        </button>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <h1 class="mb-8 text-3xl font-bold">Panel de administración</h1>

      <!-- Formulario crear / editar -->
      <section class="mb-10 rounded-2xl border border-[#2a2a2a] bg-[#1a1a1a] p-6">
        <h2 id="formTitle" class="mb-4 text-xl font-semibold">Nueva película</h2>
        <form id="peliculaForm" class="grid gap-4 sm:grid-cols-2">
          <input type="hidden" id="editId" value="" />

          <label class="flex flex-col gap-1">
            <span class="text-sm text-gray-400">Nombre *</span>
            <input
              id="fNombre"
              type="text"
              required
              maxlength="200"
              class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
            />
          </label>

          <label class="flex flex-col gap-1">
            <span class="text-sm text-gray-400">URL de imagen *</span>
            <input
              id="fImagen"
              type="url"
              required
              class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
            />
          </label>

          <label class="flex flex-col gap-1">
            <span class="text-sm text-gray-400">Año de estreno</span>
            <input
              id="fEstreno"
              type="number"
              min="1888"
              max="2100"
              class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
            />
          </label>

          <label class="flex flex-col gap-1 sm:col-span-2">
            <span class="text-sm text-gray-400">Sinopsis</span>
            <textarea
              id="fSinopsis"
              rows="3"
              class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7] resize-none"
            ></textarea>
          </label>

          <div class="flex gap-3 sm:col-span-2">
            <button
              type="submit"
              class="rounded-lg bg-[#a855f7] hover:bg-[#c084fc] transition-colors px-6 py-2 font-medium text-white"
            >
              Guardar
            </button>
            <button
              type="button"
              id="btnCancelar"
              class="hidden rounded-lg border border-[#2a2a2a] px-6 py-2 hover:border-gray-400 transition-colors"
            >
              Cancelar
            </button>
          </div>
          <p id="formMsg" class="sm:col-span-2 text-sm"></p>
        </form>
      </section>

      <!-- Lista de películas -->
      <section>
        <h2 class="mb-4 text-xl font-semibold">Películas registradas</h2>
        <p id="listaMsg" class="text-gray-400 text-sm mb-4 hidden"></p>
        <div id="listaPeliculas" class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4"></div>
      </section>
    </main>

    <!-- Modal de confirmación de eliminación -->
    <div
      id="modalEliminar"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70"
    >
      <div class="rounded-2xl border border-[#2a2a2a] bg-[#1a1a1a] p-8 max-w-sm w-full mx-4 text-center shadow-2xl">
        <h3 class="text-lg font-semibold mb-2">¿Eliminar película?</h3>
        <p id="modalNombre" class="text-gray-400 mb-6 text-sm"></p>
        <div class="flex gap-4 justify-center">
          <button
            id="btnConfirmarEliminar"
            class="rounded-lg bg-red-600 hover:bg-red-500 px-6 py-2 font-medium text-white transition-colors"
          >
            Eliminar
          </button>
          <button
            id="btnCancelarEliminar"
            class="rounded-lg border border-[#2a2a2a] px-6 py-2 hover:border-gray-400 transition-colors"
          >
            Cancelar
          </button>
        </div>
      </div>
    </div>

    <script type="module">
      import { supabase } from '/src/lib/supabase-browser.ts';

      // ─── Guardia de sesión ────────────────────────────────────────────────
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
      }

      document.getElementById('userEmail').textContent = session.user.email;

      // ─── Cerrar sesión ────────────────────────────────────────────────────
      document.getElementById('btnLogout').addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/login';
      });

      // ─── Estado local ─────────────────────────────────────────────────────
      let peliculas = [];
      let eliminarId = null;

      // ─── Elementos del DOM ────────────────────────────────────────────────
      const form        = document.getElementById('peliculaForm');
      const formTitle   = document.getElementById('formTitle');
      const formMsg     = document.getElementById('formMsg');
      const listaMsg    = document.getElementById('listaMsg');
      const lista       = document.getElementById('listaPeliculas');
      const editId      = document.getElementById('editId');
      const fNombre     = document.getElementById('fNombre');
      const fImagen     = document.getElementById('fImagen');
      const fEstreno    = document.getElementById('fEstreno');
      const fSinopsis   = document.getElementById('fSinopsis');
      const btnCancelar = document.getElementById('btnCancelar');
      const modal       = document.getElementById('modalEliminar');
      const modalNombre = document.getElementById('modalNombre');
      const btnConfirmar = document.getElementById('btnConfirmarEliminar');
      const btnCancelarEliminar = document.getElementById('btnCancelarEliminar');

      // ─── Cargar películas ─────────────────────────────────────────────────
      async function cargarPeliculas() {
        const { data, error } = await supabase
          .from('peliculas')
          .select('id, nombre, imagen, sinopsis, estreno')
          .order('nombre');

        if (error) {
          listaMsg.textContent = 'Error al cargar películas: ' + error.message;
          listaMsg.className = 'text-red-400 text-sm mb-4';
          listaMsg.classList.remove('hidden');
          return;
        }

        peliculas = data ?? [];
        renderLista();
      }

      function renderLista() {
        if (peliculas.length === 0) {
          listaMsg.textContent = 'No hay películas registradas aún.';
          listaMsg.className = 'text-gray-400 text-sm mb-4';
          listaMsg.classList.remove('hidden');
          lista.innerHTML = '';
          return;
        }
        listaMsg.classList.add('hidden');
        lista.innerHTML = peliculas.map(p => `
          <div class="overflow-hidden rounded-xl bg-[#1a1a1a] border border-[#2a2a2a] flex flex-col">
            <img
              src="${p.imagen}"
              alt="${p.nombre}"
              class="aspect-[2/3] w-full object-cover"
              onerror="this.src='https://placehold.co/300x450/1a1a1a/555?text=Sin+imagen'"
            />
            <div class="p-3 flex flex-col gap-2 flex-1">
              <h3 class="font-semibold text-sm leading-tight">${p.nombre}</h3>
              <p class="text-xs text-gray-400">${p.estreno ?? 's/f'}</p>
              <div class="flex gap-2 mt-auto">
                <button
                  data-id="${p.id}"
                  class="btn-editar flex-1 rounded-md bg-[#2a2a2a] hover:bg-[#3a3a3a] px-3 py-1.5 text-xs transition-colors"
                >
                  Editar
                </button>
                <button
                  data-id="${p.id}"
                  data-nombre="${p.nombre}"
                  class="btn-eliminar flex-1 rounded-md bg-red-900/50 hover:bg-red-700 px-3 py-1.5 text-xs transition-colors"
                >
                  Eliminar
                </button>
              </div>
            </div>
          </div>
        `).join('');

        // Delegación de eventos
        lista.querySelectorAll('.btn-editar').forEach(btn => {
          btn.addEventListener('click', () => abrirEdicion(Number(btn.dataset.id)));
        });
        lista.querySelectorAll('.btn-eliminar').forEach(btn => {
          btn.addEventListener('click', () => confirmarEliminar(Number(btn.dataset.id), btn.dataset.nombre));
        });
      }

      // ─── Crear / Editar ───────────────────────────────────────────────────
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formMsg.textContent = '';

        const payload = {
          nombre:   fNombre.value.trim(),
          imagen:   fImagen.value.trim(),
          estreno:  fEstreno.value ? Number(fEstreno.value) : null,
          sinopsis: fSinopsis.value.trim() || null,
        };

        let error;

        if (editId.value) {
          ({ error } = await supabase
            .from('peliculas')
            .update(payload)
            .eq('id', Number(editId.value)));
        } else {
          ({ error } = await supabase
            .from('peliculas')
            .insert(payload));
        }

        if (error) {
          formMsg.textContent = 'Error: ' + error.message;
          formMsg.className = 'sm:col-span-2 text-sm text-red-400';
        } else {
          formMsg.textContent = editId.value ? 'Película actualizada.' : 'Película creada.';
          formMsg.className = 'sm:col-span-2 text-sm text-green-400';
          resetForm();
          await cargarPeliculas();
        }
      });

      function abrirEdicion(id) {
        const p = peliculas.find(x => x.id === id);
        if (!p) return;
        formTitle.textContent = 'Editar película';
        editId.value    = p.id;
        fNombre.value   = p.nombre;
        fImagen.value   = p.imagen;
        fEstreno.value  = p.estreno ?? '';
        fSinopsis.value = p.sinopsis ?? '';
        btnCancelar.classList.remove('hidden');
        formMsg.textContent = '';
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function resetForm() {
        formTitle.textContent = 'Nueva película';
        editId.value    = '';
        fNombre.value   = '';
        fImagen.value   = '';
        fEstreno.value  = '';
        fSinopsis.value = '';
        btnCancelar.classList.add('hidden');
      }

      btnCancelar.addEventListener('click', () => {
        resetForm();
        formMsg.textContent = '';
      });

      // ─── Eliminar ─────────────────────────────────────────────────────────
      function confirmarEliminar(id, nombre) {
        eliminarId = id;
        modalNombre.textContent = `"${nombre}"`;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      btnCancelarEliminar.addEventListener('click', cerrarModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrarModal(); });

      function cerrarModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        eliminarId = null;
      }

      btnConfirmar.addEventListener('click', async () => {
        if (!eliminarId) return;
        const { error } = await supabase
          .from('peliculas')
          .delete()
          .eq('id', eliminarId);

        cerrarModal();

        if (error) {
          listaMsg.textContent = 'Error al eliminar: ' + error.message;
          listaMsg.className = 'text-red-400 text-sm mb-4';
          listaMsg.classList.remove('hidden');
        } else {
          await cargarPeliculas();
        }
      });

      // ─── Init ─────────────────────────────────────────────────────────────
      await cargarPeliculas();
    </script>
  </body>
</html>
