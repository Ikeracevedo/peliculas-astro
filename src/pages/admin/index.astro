---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin | CineVault">
  <!-- Header específico del admin con email y logout -->
  <div class="flex items-center justify-end gap-4 border-b border-[#2a2a2a] bg-[#0e0e0e] px-6 py-2 text-sm">
    <span id="userEmail" class="text-gray-400"></span>
    <button
      id="btnLogout"
      class="rounded-lg border border-[#a855f7] px-4 py-1 text-[#a855f7] hover:bg-[#a855f7] hover:text-white transition-colors"
    >
      Cerrar sesión
    </button>
  </div>

  <main class="mx-auto max-w-6xl px-6 py-10">
    <h1 class="mb-8 text-3xl font-bold">Panel de administración</h1>

    <!-- Formulario crear / editar -->
    <section class="mb-10 rounded-2xl border border-[#2a2a2a] bg-[#1a1a1a] p-6">
      <h2 id="formTitle" class="mb-4 text-xl font-semibold">Nueva película</h2>
      <form id="peliculaForm" class="grid gap-4 sm:grid-cols-2">
        <input type="hidden" id="editId" value="" />

        <label class="flex flex-col gap-1">
          <span class="text-sm text-gray-400">Nombre *</span>
          <input
            id="fNombre"
            type="text"
            required
            maxlength="200"
            class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
          />
        </label>

        <label class="flex flex-col gap-1">
          <span class="text-sm text-gray-400">URL de imagen *</span>
          <input
            id="fImagen"
            type="url"
            required
            class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
          />
        </label>

        <label class="flex flex-col gap-1">
          <span class="text-sm text-gray-400">Año de estreno</span>
          <input
            id="fEstreno"
            type="number"
            min="1888"
            max="2100"
            class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
          />
        </label>

        <label class="flex flex-col gap-1 sm:col-span-2">
          <span class="text-sm text-gray-400">Sinopsis</span>
          <textarea
            id="fSinopsis"
            rows="3"
            class="resize-none rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
          ></textarea>
        </label>

        <div class="flex gap-3 sm:col-span-2">
          <button
            type="submit"
            class="rounded-lg bg-[#a855f7] hover:bg-[#c084fc] transition-colors px-6 py-2 font-medium text-white"
          >
            Guardar
          </button>
          <button
            type="button"
            id="btnCancelar"
            class="hidden rounded-lg border border-[#2a2a2a] px-6 py-2 hover:border-gray-400 transition-colors"
          >
            Cancelar
          </button>
        </div>
        <p id="formMsg" class="sm:col-span-2 text-sm"></p>
      </form>
    </section>

    <!-- Lista de películas -->
    <section>
      <h2 class="mb-4 text-xl font-semibold">Películas registradas</h2>
      <p id="listaMsg" class="mb-4 hidden text-sm text-gray-400"></p>
      <div id="listaPeliculas" class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4"></div>
    </section>
  </main>

  <!-- Modal de confirmación de eliminación -->
  <div
    id="modalEliminar"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70"
  >
    <div class="mx-4 w-full max-w-sm rounded-2xl border border-[#2a2a2a] bg-[#1a1a1a] p-8 text-center shadow-2xl">
      <h3 class="mb-2 text-lg font-semibold">¿Eliminar película?</h3>
      <p id="modalNombre" class="mb-6 text-sm text-gray-400"></p>
      <div class="flex justify-center gap-4">
        <button
          id="btnConfirmarEliminar"
          class="rounded-lg bg-red-600 hover:bg-red-500 px-6 py-2 font-medium text-white transition-colors"
        >
          Eliminar
        </button>
        <button
          id="btnCancelarEliminar"
          class="rounded-lg border border-[#2a2a2a] px-6 py-2 hover:border-gray-400 transition-colors"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase-browser';

  async function init() {
    // ─── Guardia de sesión ──────────────────────────────────────────────────
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }

    const emailEl      = document.getElementById('userEmail');
    const btnLogout    = document.getElementById('btnLogout');
    const form         = document.getElementById('peliculaForm') as HTMLFormElement;
    const formTitle    = document.getElementById('formTitle')!;
    const formMsg      = document.getElementById('formMsg')!;
    const listaMsg     = document.getElementById('listaMsg')!;
    const lista        = document.getElementById('listaPeliculas')!;
    const editId       = document.getElementById('editId') as HTMLInputElement;
    const fNombre      = document.getElementById('fNombre') as HTMLInputElement;
    const fImagen      = document.getElementById('fImagen') as HTMLInputElement;
    const fEstreno     = document.getElementById('fEstreno') as HTMLInputElement;
    const fSinopsis    = document.getElementById('fSinopsis') as HTMLTextAreaElement;
    const btnCancelar  = document.getElementById('btnCancelar')!;
    const modal        = document.getElementById('modalEliminar')!;
    const modalNombre  = document.getElementById('modalNombre')!;
    const btnConfirmar = document.getElementById('btnConfirmarEliminar')!;
    const btnCancelEliminar = document.getElementById('btnCancelarEliminar')!;

    if (emailEl) emailEl.textContent = session.user.email ?? '';

    // ─── Cerrar sesión ──────────────────────────────────────────────────────
    btnLogout?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    // ─── Estado ─────────────────────────────────────────────────────────────
    let peliculas: { id: number; nombre: string; imagen: string; sinopsis: string | null; estreno: number | null }[] = [];
    let eliminarId: number | null = null;

    // ─── Cargar películas ───────────────────────────────────────────────────
    async function cargarPeliculas() {
      const { data, error } = await supabase
        .from('peliculas')
        .select('id, nombre, imagen, sinopsis, estreno')
        .order('nombre');

      if (error) {
        listaMsg.textContent = 'Error al cargar películas: ' + error.message;
        listaMsg.className = 'mb-4 text-sm text-red-400';
        listaMsg.classList.remove('hidden');
        return;
      }

      peliculas = data ?? [];
      renderLista();
    }

    function renderLista() {
      if (peliculas.length === 0) {
        listaMsg.textContent = 'No hay películas registradas aún.';
        listaMsg.className = 'mb-4 text-sm text-gray-400';
        listaMsg.classList.remove('hidden');
        lista.innerHTML = '';
        return;
      }
      listaMsg.classList.add('hidden');

      // Los datos de las películas los escribe cualquier usuario autenticado, así que
      // se construyen los nodos con textContent / propiedades del DOM y NO con
      // innerHTML: el navegador trata el valor como texto, nunca como HTML (evita XSS).
      lista.replaceChildren(...peliculas.map(crearTarjeta));
    }

    function crearTarjeta(p: (typeof peliculas)[number]): HTMLElement {
      const tarjeta = document.createElement('div');
      tarjeta.className = 'flex flex-col overflow-hidden rounded-xl border border-[#2a2a2a] bg-[#1a1a1a]';

      const img = document.createElement('img');
      img.alt = p.nombre;
      img.className = 'aspect-[2/3] w-full object-cover';
      img.addEventListener('error', () => {
        img.src = 'https://placehold.co/300x450/1a1a1a/555?text=Sin+imagen';
      }, { once: true });
      img.src = p.imagen;

      const cuerpo = document.createElement('div');
      cuerpo.className = 'flex flex-1 flex-col gap-2 p-3';

      const titulo = document.createElement('h3');
      titulo.className = 'text-sm font-semibold leading-tight';
      titulo.textContent = p.nombre;

      const anio = document.createElement('p');
      anio.className = 'text-xs text-gray-400';
      anio.textContent = String(p.estreno ?? 's/f');

      const acciones = document.createElement('div');
      acciones.className = 'mt-auto flex gap-2';

      const btnEditar = document.createElement('button');
      btnEditar.className = 'flex-1 rounded-md bg-[#2a2a2a] px-3 py-1.5 text-xs transition-colors hover:bg-[#3a3a3a]';
      btnEditar.textContent = 'Editar';
      btnEditar.addEventListener('click', () => abrirEdicion(p.id));

      const btnEliminar = document.createElement('button');
      btnEliminar.className = 'flex-1 rounded-md bg-red-900/50 px-3 py-1.5 text-xs transition-colors hover:bg-red-700';
      btnEliminar.textContent = 'Eliminar';
      btnEliminar.addEventListener('click', () => confirmarEliminar(p.id, p.nombre));

      acciones.append(btnEditar, btnEliminar);
      cuerpo.append(titulo, anio, acciones);
      tarjeta.append(img, cuerpo);
      return tarjeta;
    }

    // ─── Formulario crear / editar ──────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formMsg.textContent = '';

      const payload = {
        nombre:   fNombre.value.trim(),
        imagen:   fImagen.value.trim(),
        estreno:  fEstreno.value ? Number(fEstreno.value) : null,
        sinopsis: fSinopsis.value.trim() || null,
      };

      let error;
      if (editId.value) {
        ({ error } = await supabase.from('peliculas').update(payload).eq('id', Number(editId.value)));
      } else {
        ({ error } = await supabase.from('peliculas').insert(payload));
      }

      if (error) {
        formMsg.textContent = 'Error: ' + error.message;
        formMsg.className = 'sm:col-span-2 text-sm text-red-400';
      } else {
        formMsg.textContent = editId.value ? '✓ Película actualizada.' : '✓ Película creada.';
        formMsg.className = 'sm:col-span-2 text-sm text-green-400';
        resetForm();
        await cargarPeliculas();
      }
    });

    function abrirEdicion(id: number) {
      const p = peliculas.find(x => x.id === id);
      if (!p) return;
      formTitle.textContent = 'Editar película';
      editId.value    = String(p.id);
      fNombre.value   = p.nombre;
      fImagen.value   = p.imagen;
      fEstreno.value  = p.estreno != null ? String(p.estreno) : '';
      fSinopsis.value = p.sinopsis ?? '';
      btnCancelar.classList.remove('hidden');
      formMsg.textContent = '';
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetForm() {
      formTitle.textContent = 'Nueva película';
      editId.value    = '';
      fNombre.value   = '';
      fImagen.value   = '';
      fEstreno.value  = '';
      fSinopsis.value = '';
      btnCancelar.classList.add('hidden');
    }

    btnCancelar.addEventListener('click', () => {
      resetForm();
      formMsg.textContent = '';
    });

    // ─── Eliminar ───────────────────────────────────────────────────────────
    function confirmarEliminar(id: number, nombre: string) {
      eliminarId = id;
      modalNombre.textContent = `"${nombre}"`;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function cerrarModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      eliminarId = null;
    }

    btnCancelEliminar.addEventListener('click', cerrarModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) cerrarModal(); });

    btnConfirmar.addEventListener('click', async () => {
      if (!eliminarId) return;
      const { error } = await supabase.from('peliculas').delete().eq('id', eliminarId);
      cerrarModal();
      if (error) {
        listaMsg.textContent = 'Error al eliminar: ' + error.message;
        listaMsg.className = 'mb-4 text-sm text-red-400';
        listaMsg.classList.remove('hidden');
      } else {
        await cargarPeliculas();
      }
    });

    // ─── Init ───────────────────────────────────────────────────────────────
    await cargarPeliculas();
  }

  document.addEventListener('astro:page-load', init);
</script>
