---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro | CineVault">
  <section class="mx-auto max-w-md mt-10 px-6 py-10">
    <h1 class="text-2xl font-bold mb-6">Crear cuenta</h1>
    <form id="registroForm" class="flex flex-col gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-sm text-gray-400">Correo electrónico</span>
        <input
          type="email"
          name="email"
          required
          class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-sm text-gray-400">Contraseña</span>
        <input
          type="password"
          name="password"
          required
          minlength="6"
          class="rounded-lg border border-[#2a2a2a] bg-[#0e0e0e] px-4 py-2 focus:outline-none focus:border-[#a855f7]"
        />
      </label>
      <button
        type="submit"
        class="rounded-lg bg-[#a855f7] hover:bg-[#c084fc] transition-colors px-5 py-2 font-medium text-white"
      >
        Registrarse
      </button>
    </form>
    <p id="message" class="mt-4 text-center text-sm"></p>
    <p class="mt-6 text-center text-sm text-gray-500">
      ¿Ya tienes cuenta? <a href="/login" class="text-[#a855f7] hover:underline">Inicia sesión</a>
    </p>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase-browser';

  function init() {
    const form = document.getElementById('registroForm') as HTMLFormElement | null;
    const messageEl = document.getElementById('message');
    if (!form || !messageEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      messageEl.textContent = '';
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;

      const { data, error } = await supabase.auth.signUp({ email, password });
      if (error) {
        messageEl.textContent = error.message;
        messageEl.className = 'mt-4 text-center text-sm text-red-400';
      } else if (data.session) {
        // "Confirm email" desactivado en Supabase: signUp ya devuelve sesión activa.
        window.location.href = '/admin';
      } else {
        // "Confirm email" activado: la cuenta existe pero falta confirmar el correo.
        messageEl.textContent = 'Registro exitoso. Revisa tu correo para confirmar la cuenta.';
        messageEl.className = 'mt-4 text-center text-sm text-green-400';
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
