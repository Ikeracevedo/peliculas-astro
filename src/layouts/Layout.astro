---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[#121212] text-gray-200">
    <header class="flex items-center justify-between border-b border-[#2a2a2a] px-6 py-4">
      <a href="/" class="text-xl font-bold text-[#a855f7]">CineVault</a>
      <nav class="flex gap-6 text-sm">
        <a href="/" class="hover:text-white">Catálogo</a>
        <a href="/acerca" class="hover:text-white">Acerca de</a>
        <a href="/admin" class="hover:text-white">Admin</a>
        <a href="/login" class="hover:text-white">Ingresar</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
