---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[#121212] text-gray-200">
    <header class="flex items-center justify-between border-b border-[#2a2a2a] px-6 py-4">
      <a href="/" class="text-xl font-bold text-[#a855f7]">CineVault</a>
      <nav class="flex items-center gap-6 text-sm">
        <a href="/" class="hover:text-white">Catálogo</a>
        <a href="/acerca" class="hover:text-white">Acerca de</a>
        <!-- Estos se muestran/ocultan según la sesión -->
        <a id="nav-admin" href="/admin" class="hidden hover:text-white">Admin</a>
        <a id="nav-login" href="/login" class="hover:text-white">Ingresar</a>
        <button
          id="nav-logout"
          class="hidden rounded-lg border border-[#a855f7] px-3 py-1 text-[#a855f7] hover:bg-[#a855f7] hover:text-white transition-colors"
        >
          Cerrar sesión
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  import { supabase } from '../lib/supabase-browser';

  async function actualizarNav() {
    const navAdmin  = document.getElementById('nav-admin');
    const navLogin  = document.getElementById('nav-login');
    const navLogout = document.getElementById('nav-logout');
    if (!navAdmin || !navLogin || !navLogout) return;

    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      navAdmin.classList.remove('hidden');
      navLogin.classList.add('hidden');
      navLogout.classList.remove('hidden');
    } else {
      navAdmin.classList.add('hidden');
      navLogin.classList.remove('hidden');
      navLogout.classList.add('hidden');
    }

    navLogout.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });
  }

  document.addEventListener('astro:page-load', actualizarNav);
</script>
